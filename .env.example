# Copy this file to ".env" and fill in your bot token.
# Get the token from: https://discord.com/developers/applications
#   → your application → Bot → "Reset Token" → copy.
# NEVER commit the real .env — it's gitignored.
DISCORD_TOKEN=paste-your-bot-token-here

# Activity Tracker submission (Supabase discord-submit Edge Function).
# ACTIVITY_FN_URL     — the function URL, e.g. https://<ref>.supabase.co/functions/v1/discord-submit
# ACTIVITY_BOT_SECRET — the shared secret set as the function's DISCORD_BOT_SECRET.
ACTIVITY_FN_URL=https://your-project.supabase.co/functions/v1/discord-submit
ACTIVITY_BOT_SECRET=paste-the-shared-bot-secret-here
